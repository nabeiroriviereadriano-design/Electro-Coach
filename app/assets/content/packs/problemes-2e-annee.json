   "title": "Problème — Fiabilité d'un lot de variateurs",
   "difficulty": 3,
   "validated": false,
   "params": {
    "n": {
     "unit": "",
     "values": [
      10,
      20,
      25
     ]
    },
    "p": {
     "unit": "",
     "values": [
      0.02,
      0.05,
      0.1
     ]
    }
   },
   "vars": {},
   "constraints": [],
   "statement": [
    {
     "type": "text",
     "text": "Un atelier installe [[n]] variateurs identiques. Chacun tombe en panne pendant la première année avec une probabilité $p =$ [[p]], indépendamment des autres. On note $X$ le nombre de variateurs en panne la première année."
    }
   ],
   "questions": [
    {
     "id": "q1",
     "kind": "choice",
     "prompt": "La loi de $X$ est :",
     "choices": [
      "binomiale de paramètres n = [[n]] et p = [[p]]",
      "uniforme sur [0 ; [[n]]]",
      "normale centrée réduite"
     ],
     "correct": 0
    },
    {
     "id": "q2",
     "kind": "numeric",
     "prompt": "$P(X = 0)$ ?",
     "answer": "(1 - p)^n",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q3",
     "kind": "numeric",
     "prompt": "$P(X = 1)$ ?",
     "answer": "n*p*(1 - p)^(n - 1)",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q4",
     "kind": "numeric",
     "prompt": "$P(X \\geq 2)$ ?",
     "answer": "1 - (1 - p)^n - n*p*(1 - p)^(n - 1)",
     "unit": "",
     "tolerance": 0.02,
     "sig": 3
    },
    {
     "id": "q5",
     "kind": "numeric",
     "prompt": "Espérance de $X$ ?",
     "answer": "n*p",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q6",
     "kind": "numeric",
     "prompt": "Écart type de $X$ ?",
     "answer": "sqrt(n*p*(1 - p))",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    }
   ],
   "hint": "P(X = k) = C(n, k) pᵏ (1 − p)ⁿ⁻ᵏ.",
   "method": "Répétition d'épreuves indépendantes à deux issues → loi binomiale ; P(X ≥ 2) = 1 − P(X = 0) − P(X = 1).",
   "solution": [
    {
     "type": "text",
     "text": "$X \\sim \\mathcal B([[n]] ; [[p]])$. $P(X = 0) \\approx$ [[=(1-p)^n:3]] ; $P(X = 1) \\approx$ [[=n*p*(1-p)^(n-1):3]] ; $P(X \\geq 2) \\approx$ [[=1-(1-p)^n-n*p*(1-p)^(n-1):3]]."
    },
    {
     "type": "text",
     "text": "$E(X) = np = [[=n*p]]$ ; $\\sigma = \\sqrt{np(1-p)} \\approx$ [[=sqrt(n*p*(1-p)):3]]."
    }
   ]
  },
  {
