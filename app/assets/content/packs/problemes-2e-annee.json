   "vars": {},
   "constraints": [],
   "statement": [
    {
     "type": "text",
     "text": "Une machine fabrique des résistances dont la valeur $X$ (en Ω) suit une loi normale de moyenne $\\mu =$ [[m]] et d'écart type $\\sigma =$ [[s]]. On rappelle : $P(\\mu - \\sigma \\le X \\le \\mu + \\sigma) \\approx 0{,}683$, $P(\\mu - 2\\sigma \\le X \\le \\mu + 2\\sigma) \\approx 0{,}954$."
    }
   ],
   "questions": [
    {
     "id": "q1",
