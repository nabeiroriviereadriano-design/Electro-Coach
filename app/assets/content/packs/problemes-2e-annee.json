      20
     ]
    }
   },
   "vars": {
    "a": "R/(2*L)",
    "b": "sqrt(1/(L*C) - (R/(2*L))^2)"
   },
   "constraints": [
    "R^2 < 4*L/C"
   ],
   "statement": [
    {
     "type": "text",
     "text": "La tension $u$ aux bornes du condensateur d'un circuit RLC série en régime libre ($R =$ [[R]] Ω, $L =$ [[L]] H, $C =$ [[C]] F) vérifie :"
    },
    {
     "type": "formula",
     "tex": "LC\\,u'' + RC\\,u' + u = 0",
     "title": ""
    },
    {
     "type": "text",
     "text": "avec $u(0) = [[U0]]$ V et $u'(0) = 0$."
    }
   ],
   "questions": [
    {
     "id": "q1",
     "kind": "numeric",
     "prompt": "Discriminant de l'équation caractéristique $LCr^2 + RCr + 1 = 0$ ?",
     "answer": "(R*C)^2 - 4*L*C",
     "unit": "",
     "tolerance": 0.02,
     "sig": 3
    },
    {
     "id": "q2",
     "kind": "choice",
     "prompt": "Le régime est :",
     "choices": [
      "pseudo-périodique (oscillations amorties)",
      "apériodique",
      "critique"
     ],
     "correct": 0
    },
    {
     "id": "q3",
     "kind": "numeric",
     "prompt": "Partie réelle des racines, $-\\alpha$ ?",
     "answer": "-a",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q4",
     "kind": "numeric",
     "prompt": "Partie imaginaire positive des racines, $\\beta$ (rad/s) ?",
     "answer": "b",
     "unit": "",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q5",
     "kind": "numeric",
     "prompt": "Pseudo-période $2\\pi/\\beta$ (s) ?",
     "answer": "2*pi/b",
     "unit": "s",
     "tolerance": 0.01,
     "sig": 3
    },
    {
     "id": "q6",
     "kind": "numeric",
     "prompt": "La solution est $u = e^{-\\alpha t}(A\\cos\\beta t + B\\sin\\beta t)$ avec $A = [[U0]]$. Valeur de $B = \\alpha A/\\beta$ ?",
     "answer": "a*U0/b",
     "unit": "",
     "tolerance": 0.02,
     "sig": 3
    }
   ],
   "hint": "Δ < 0 → racines complexes −α ± jβ.",
   "method": "1. Équation caractéristique.\n2. Signe du discriminant.\n3. Racines complexes conjuguées.\n4. Conditions initiales.",
   "solution": [
    {
     "type": "text",
     "text": "$\\Delta = (RC)^2 - 4LC \\approx$ [[=(R*C)^2-4*L*C:3]] < 0 : racines $-\\alpha \\pm j\\beta$ avec $\\alpha =$ [[=a:3]] et $\\beta \\approx$ [[=b:3]] rad/s."
    },
    {
     "type": "text",
     "text": "Pseudo-période ≈ [[=2*pi/b:3|s]] ; $u'(0) = -\\alpha A + \\beta B = 0$ donne $B \\approx$ [[=a*U0/b:3]]."
    }
   ]
  },
