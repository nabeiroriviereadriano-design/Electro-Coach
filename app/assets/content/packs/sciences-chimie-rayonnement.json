   ],
   "title": "Photométrie",
   "validated": false,
   "blocks": [
    {
     "type": "table",
     "rows": [
      [
       "Grandeur",
       "Unité",
       "Sens"
      ],
      [
       "puissance électrique",
       "W",
       "consommée par la source"
      ],
      [
       "flux lumineux Φ",
       "lumen (lm)",
       "lumière émise, pondérée par la sensibilité de l'œil"
      ],
